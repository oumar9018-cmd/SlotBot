# Copy to .env and fill in. NEVER commit .env.

# OpenAI — server-side only, never expose to frontend
OPENAI_API_KEY=
# Realtime voice model (override if OpenAI ships a newer GA model)
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview-2024-12-17
# Scoring judge model
OPENAI_SCORING_MODEL=gpt-4o

# Telegram — bot token for Stars invoices + payment webhook (from @BotFather)
TELEGRAM_BOT_TOKEN=
# Optional: secret token for webhook verification (set the same value via setWebhook)
TELEGRAM_WEBHOOK_SECRET=

# Firebase — path to service-account JSON on the server
FIREBASE_CRED_PATH=/secrets/firebase-service-account.json
