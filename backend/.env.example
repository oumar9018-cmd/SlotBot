# Copy to .env and fill in. NEVER commit .env.

# Grok (xAI) — dialogue engine + transcript scoring, server-side only
XAI_API_KEY=
# Optional overrides (defaults: grok-3 -> grok-2-1212 fallback)
XAI_MODEL=grok-3
XAI_MODEL_FALLBACK=grok-2-1212
XAI_SCORING_MODEL=grok-3

# Deepgram — speech-to-text (streaming) + text-to-speech, server-side only
DEEPGRAM_API_KEY=

# Telegram — bot token for Stars invoices + payment webhook (from @BotFather)
TELEGRAM_BOT_TOKEN=
# Optional: secret token for webhook verification (set the same value via setWebhook)
TELEGRAM_WEBHOOK_SECRET=

# Firebase — path to service-account JSON on the server
FIREBASE_CRED_PATH=/secrets/firebase-service-account.json
