# --- REQUIRED: get from @BotFather on Telegram ---
BOT_TOKEN=123456789:AAH...your-bot-token-here
BOT_USERNAME=slotbot

# --- REQUIRED: random secret for webhook verification (generate: openssl rand -hex 32) ---
WEBHOOK_SECRET=change-me-to-a-random-32-byte-hex-string

# --- REQUIRED in production: public HTTPS base URL of this server ---
# Used for setWebhook and Mini App URL. Example: https://slotbot.onrender.com
BASE_URL=https://your-public-url.example.com

# --- Optional ---
# Database file path (default: ./data/slotbot.db)
DB_PATH=./data/slotbot.db
# Run Telegram in polling mode instead of webhook (local dev only)
POLLING=false
# Log level
LOG_LEVEL=INFO
